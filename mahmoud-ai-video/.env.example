# Speech generation (defaults to OpenAI Speech)
TTS_API_KEY=
TTS_PROVIDER_URL=https://api.openai.com/v1/audio/speech
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Video provider and render worker are not implemented yet
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_URL=
VIDEO_MODEL=
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=
